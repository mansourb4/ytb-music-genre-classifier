# Jeton personnel Discogs : https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# User-Agent obligatoire pour l'API Discogs (identifie ton application)
DISCOGS_USER_AGENT=ytb-music-genre-classifier/0.1 +https://github.com/mansourb4/ytb-music-genre-classifier

# Chemin du fichier d'authentification ytmusicapi (voir README)
YTMUSIC_AUTH_FILE=browser.json

# Clé Last.fm, pour les tags par titre : https://www.last.fm/api/account/create
# Facultative — sans elle, le classement s'appuie sur les seuls styles Discogs.
LASTFM_API_KEY=
