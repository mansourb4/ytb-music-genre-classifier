__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.env
config/config.toml
# Tout ce qui est reconstructible : base SQLite, caches, lot en cours.
data/*
# Sauf les verdicts du modèle. Ce sont les seules données du projet qui se
# paient : elles doivent survivre à un `rm -rf data/`, à un changement de
# machine et à une réinstallation. Le fichier est fait pour ça — texte, une
# ligne par titre, lisible dans un diff.
!data/verdicts.txt
# Les déplacements faits à la main : même raison, ce sont des décisions.
!data/placements.txt
# Les propositions de la relecture par Claude, en attente de décision.
!data/propositions.txt
# Le pays des artistes : une connaissance, pas un cache.
!data/pays.txt
*.db
*.db-journal
headers_auth.json
oauth.json
oauth_client.json
browser.json
